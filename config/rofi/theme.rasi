/* Wallust cyber launcher with Suisei/vocaloid accent language. */

@import "~/.config/rofi/wallust/colors-rofi.rasi"

* {
    bg: @background;
    surface: @color0;
    fg: @foreground;
    muted: @color8;
    accent: @color12;
    accent2: @color14;
    urgent: @color1;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Bold 12";
}

window {
    background-color: @bg;
    border: 1px solid;
    border-color: @accent;
    border-radius: 8px;
    width: 620px;
    padding: 10px;
    location: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @surface;
    border: 1px solid;
    border-color: @accent;
    border-radius: 6px;
    padding: 8px 10px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent2;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search / 検索...";
    placeholder-color: @muted;
    cursor: text;
}

listview {
    background-color: transparent;
    padding: 0;
    spacing: 5px;
    lines: 10;
    columns: 1;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg;
    padding: 8px 10px;
    border: 1px solid;
    border-color: transparent;
    border-radius: 6px;
    spacing: 10px;
    children: [ element-icon, element-text ];
}

element selected.normal {
    background-color: @surface;
    text-color: @accent2;
    border-color: @accent;
}

element normal.urgent,
element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
    border-color: @urgent;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
