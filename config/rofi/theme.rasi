/* Blue Archive / Hayase Yuuka, early-2000s Linux launcher. */

@import "~/.config/rofi/wallust/colors-rofi.rasi"

* {
    bg: @color15;
    fg: @background;
    light: @color7;
    shadow: @color8;
    accent: @color12;
    accent2: @color13;
    edge: @color4;

    background-color: transparent;
    text-color: @fg;
    font: "Noto Sans CJK JP Bold 12";
}

window {
    background-color: @bg;
    border: 2px solid;
    border-color: @shadow;
    border-radius: 0;
    width: 520px;
    padding: 3px;
    location: center;
}

mainbox {
    background-color: @bg;
    border: 1px solid;
    border-color: @light;
    children: [ inputbar, listview ];
    spacing: 3px;
}

inputbar {
    background-color: @accent;
    border: 1px solid;
    border-color: @shadow;
    padding: 5px 7px;
    spacing: 6px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg;
}

entry {
    background-color: @light;
    text-color: @fg;
    border: 1px solid;
    border-color: @shadow;
    padding: 2px 5px;
    placeholder: "コマンド入力...";
    placeholder-color: @shadow;
    cursor: text;
}

listview {
    background-color: @light;
    border: 1px solid;
    border-color: @shadow;
    padding: 3px;
    spacing: 1px;
    lines: 10;
    columns: 1;
    scrollbar: true;
}

element {
    background-color: @light;
    text-color: @fg;
    padding: 4px 6px;
    border-radius: 0;
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element selected.normal {
    background-color: @accent;
    text-color: @fg;
    border: 1px solid;
    border-color: @edge;
}

element normal.urgent,
element selected.urgent {
    background-color: @accent2;
    text-color: @fg;
}

element-icon {
    size: 20px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

scrollbar {
    background-color: @bg;
    handle-color: @shadow;
    handle-width: 8px;
    border: 1px solid;
    border-color: @shadow;
}
