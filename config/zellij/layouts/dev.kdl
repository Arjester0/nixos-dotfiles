layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="Code 星" focus=true {
    pane split_direction="vertical" {
      pane name="Editor" size="68%" focus=true
      pane split_direction="horizontal" size="32%" {
        pane name="Run" size="55%"
        pane name="Ops" size="45%"
      }
    }
  }
}
